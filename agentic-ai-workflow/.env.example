# PostgreSQL Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentic_workflow_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_workflow_db

# LLM Provider Configuration
# Supported providers: ollama, openai, groq, openrouter
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# LLM API Keys (Required if LLM_PROVIDER is not ollama)
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-...

# Token Optimization Settings
MAX_TOKEN_LIMIT=4096
COMPRESS_PROMPTS=true

# ClickUp Integration (Optional - Falls back to mock mode if not configured)
CLICKUP_API_KEY=pk_12345678_...
CLICKUP_LIST_ID=901200345

# GitHub Integration (Optional - Falls back to mock mode if not configured)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=yusufansari563/healthcare-workspace

# Email Notification Settings (Optional - Falls back to console log if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=[EMAIL_ADDRESS]
SMTP_PASSWORD=your_gmail_app_password
NOTIFICATION_EMAIL=[EMAIL_ADDRESS]

# FastAPI Application Settings
PORT=8000
DEBUG=true
